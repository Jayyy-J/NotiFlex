{
  "name": "flexnotify",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/scraper",
    "packages/api",
    "packages/shared"
  ],
  "scripts": {
    "dev:web": "cd apps/web && npm run dev",
    "dev:api": "cd packages/api && npm run dev",
    "dev:scraper": "cd apps/scraper && python src/main.py",
    "build:web": "cd apps/web && npm run build",
    "build:api": "cd packages/api && npm run build"
  }
}
