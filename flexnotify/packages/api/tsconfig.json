{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": false,          
    "skipLibCheck": true,     
    "noImplicitAny": false,  
    "declaration": false,     
    "sourceMap": false        
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
